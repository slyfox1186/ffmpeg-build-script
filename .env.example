# Settings for build-ffmpeg.py, read from a file named .env beside the script.
#
# To use it:
#   cp .env.example .env
#   then, in .env, delete the "# " in front of each NAME=value line you want
#   to change and edit its value.
#
# Every value shown below is the default (an empty value means the default),
# so a setting uncommented unchanged changes nothing.
#
# Rules:
#   - One NAME=value per line; do not write `export`.
#   - Put quotes around a value that contains spaces: NAME="a b".
#   - ~ and $VARIABLES are not expanded; write full paths.
#   - A variable set in your shell wins over this file for that run:
#       BUILD_ROOT=/tmp/scratch python3 build-ffmpeg.py --build
#   - A name that is not listed here is reported and ignored.
#   - Git ignores .env, so your settings stay on this computer.


# ===== Workspace =============================================================

# Folder that holds the downloaded sources, the compiled libraries and the
# build log. A relative path is taken from the folder you run the script from.
# The path may not contain spaces. Keep using the same value for later builds
# and for --cleanup.
# Default: build/ in this checkout
# BUILD_ROOT=


# ===== Terminal output =======================================================

# Set to 1 to never color the output, for example when your terminal shows
# stray characters.
# Default: empty (color on a terminal)
# NO_COLOR=

# Set to 1 to color the output even when it is piped or redirected. NO_COLOR
# wins when both are set.
# Default: empty (color only on a terminal)
# FORCE_COLOR=

# ON streams every command's full output to the terminal while it runs, for
# troubleshooting a failed build. The build log is written either way. Allowed:
# ON or OFF.
# Default: OFF
# FFMPEG_BUILD_DEBUG=OFF


# ===== NVIDIA CUDA ===========================================================

# CUDA is used only with --enable-gpl-and-non-free and nv-codec-headers = true.
# What to do when this computer has an NVIDIA GPU but no CUDA toolkit: ask asks
# before installing it from NVIDIA's signed APT repository, always installs it
# without asking, never leaves CUDA alone. The NVIDIA display driver is never
# installed or changed. Allowed: ask, always or never.
# Default: ask
# CUDA_INSTALL=ask

# Which GPUs the CUDA code is compiled for: native for the GPUs in this
# computer, all for every GPU the toolkit supports (runs anywhere, builds
# slower), custom for the list in CUDA_ARCHITECTURES. Allowed: native, all or
# custom.
# Default: native
# CUDA_ARCH_MODE=native

# GPU compute capabilities without the dot, separated by spaces and quoted, for
# example "86 89" for RTX 30 and RTX 40 series cards. Read only when
# CUDA_ARCH_MODE is custom.
# Default: empty (used only with CUDA_ARCH_MODE=custom, which requires it)
# CUDA_ARCHITECTURES=


# ===== Downloads =============================================================

# Seconds to wait for a download server to answer.
# Default: 5
# DOWNLOAD_CONNECT_TIMEOUT=5

# Seconds one download may take in total. Raise it on a slow connection.
# Default: 1800 (30 minutes)
# DOWNLOAD_MAX_TIME=1800

# How many times a failed download is retried. 0 turns retries off.
# Default: 5
# DOWNLOAD_RETRY=5

# Seconds to wait between download retries. 0 retries at once.
# Default: 5
# DOWNLOAD_RETRY_DELAY=5

# Largest source archive, in bytes, that will be downloaded. A larger file is
# refused as a safety limit.
# Default: 1073741824 (1 GiB)
# DOWNLOAD_MAX_BYTES=1073741824

# Largest total size, in bytes, that one archive may unpack to. Raise it only
# for an unusually large source release.
# Default: 8589934592 (8 GiB)
# DOWNLOAD_MAX_EXTRACTED_BYTES=8589934592

# Most files and folders one archive may contain. Raise it only for an
# unusually large source release.
# Default: 100000
# DOWNLOAD_MAX_MEMBERS=100000


# ===== Release lookups =======================================================

# Seconds one check for a project's newest release may take.
# Default: 15
# VERSION_CHECK_MAX_TIME=15

# Seconds to read FreeType's release list from savannah.gnu.org before trying
# FreeDesktop's GitLab instead.
# Default: 5
# FREEDESKTOP_RELEASE_INDEX_MAX_TIME=5

# Seconds to wait for savannah.gnu.org to answer that FreeType release check.
# Default: DOWNLOAD_CONNECT_TIMEOUT when set, otherwise 2
# FREEDESKTOP_RELEASE_CONNECT_TIMEOUT=


# ===== Git ===================================================================

# Seconds one Git command other than a clone may take, such as looking up a
# project's newest release.
# Default: 120 (2 minutes)
# GIT_OPERATION_TIMEOUT=120

# Seconds one Git clone may take. Raise it on a slow connection.
# Default: 1800 (30 minutes)
# GIT_CLONE_TIMEOUT=1800


# ===== Waiting for other runs ================================================

# Seconds to wait for another run of this script, from any build folder, that
# is installing system packages or installing FFmpeg into /usr/local.
# Default: 3600 (1 hour)
# HOST_MUTATION_LOCK_TIMEOUT=3600


# ===== Developers of this repository =========================================

# Set to true to keep the checkout's cache folders (ffbuild, __pycache__,
# .pytest_cache, .ruff_cache, .mypy_cache, *.egg-info), which every build and
# --cleanup otherwise delete. Only useful when you run this repository's linter
# and tests.
# Default: false
# BYPASS_CACHE_DELETE=false
